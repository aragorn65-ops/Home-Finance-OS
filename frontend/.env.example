# Optional Google Drive backup.
# For Cloudflare Pages, set this as a Pages environment variable named
# VITE_GOOGLE_CLIENT_ID so Vite can embed it at build time.
VITE_GOOGLE_CLIENT_ID=

# Authenticated HFOS accounts.
# Leave disabled for local-first builds. Enable Supabase only when running the
# Sprint 86 production-auth baseline checklist.
VITE_HFOS_AUTH_ENABLED=false
VITE_HFOS_AUTH_PROVIDER=none

# Supabase production-auth baseline.
# These values make login and auth diagnostics available; they do not enable
# remote CRUD or automatic multi-device sync.
# VITE_HFOS_AUTH_ENABLED=true
# VITE_HFOS_AUTH_PROVIDER=supabase
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Local auth shell QA only:
# VITE_HFOS_AUTH_ENABLED=true
# VITE_HFOS_AUTH_PROVIDER=prototype
