# Optional Google Drive backup.
# For Cloudflare Pages, set this as a Pages environment variable named
# VITE_GOOGLE_CLIENT_ID so Vite can embed it at build time.
VITE_GOOGLE_CLIENT_ID=

# Future authenticated HFOS accounts.
# Leave disabled for local-first alpha builds.
VITE_HFOS_AUTH_ENABLED=false
VITE_HFOS_AUTH_PROVIDER=none

# Supabase spike only.
# Do not enable for production beta until the spike passes.
# VITE_HFOS_AUTH_ENABLED=true
# VITE_HFOS_AUTH_PROVIDER=supabase
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Local auth shell QA only:
# VITE_HFOS_AUTH_ENABLED=true
# VITE_HFOS_AUTH_PROVIDER=prototype
