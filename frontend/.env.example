# Optional Google Drive backup.
# For Cloudflare Pages, set this as a Pages environment variable named
# VITE_GOOGLE_CLIENT_ID so Vite can embed it at build time.
VITE_GOOGLE_CLIENT_ID=

# Authenticated HFOS accounts.
# Leave disabled for local-first builds. For the public beta candidate, set the
# Cloudflare Pages build variables to enable the Supabase sign-in UI.
VITE_HFOS_AUTH_ENABLED=false
VITE_HFOS_AUTH_PROVIDER=none

# Supabase public beta auth and cloud baseline.
# These values make magic-link sign-in, auth diagnostics, and the authenticated
# household metadata/account-transaction snapshot/settlement cloud baseline
# available. They do not enable broad shared collaboration, multi-device
# household access, conflict resolution, or full utility/savings cloud
# persistence.
# VITE_HFOS_AUTH_ENABLED=true
# VITE_HFOS_AUTH_PROVIDER=supabase
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Local auth shell QA only:
# VITE_HFOS_AUTH_ENABLED=true
# VITE_HFOS_AUTH_PROVIDER=prototype
